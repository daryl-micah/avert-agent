{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avert.dev/schemas/change_event.schema.json",
  "title": "ChangeEvent",
  "description": "A normalized provider change, emitted by a detection source and resolved to a canonical surface identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface", "change_type", "severity", "source", "confidence", "detected_at", "provenance"],
  "properties": {
    "surface": {"$ref": "surface_id.schema.json"},
    "replacement_surface": {"anyOf": [{"$ref": "surface_id.schema.json"}, {"type": "null"}]},
    "change_type": {"type": "string", "enum": ["surface_added", "surface_removed", "type_changed", "requiredness_changed", "model_deprecated", "model_retired"]},
    "severity": {"type": "string", "enum": ["info", "warning", "breaking"]},
    "source": {"type": "string", "enum": ["sdk_diff", "model_registry"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": ["string", "null"]},
    "announced_at": {"type": ["string", "null"], "format": "date"},
    "effective_at": {"type": ["string", "null"], "format": "date"},
    "applies_from": {"type": ["string", "null"]},
    "applies_to": {"type": ["string", "null"]},
    "detected_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "package_ecosystem": {"type": ["string", "null"], "enum": ["pypi", "npm", null]},
        "package_name": {"type": ["string", "null"]},
        "from_version": {"type": ["string", "null"]},
        "to_version": {"type": ["string", "null"]}
      }
    }
  }
}
